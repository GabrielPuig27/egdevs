# URL pública do site (metadados, Open Graph, sitemap). Valor fictício de exemplo.
# Em produção, defina na Vercel; troque pelo domínio próprio quando existir.
NEXT_PUBLIC_SITE_URL=https://egdevs.example

# Demonstração de agente de IA (/agentes) — SEGREDOS, só no servidor.
# Nunca use o prefixo NEXT_PUBLIC_ nem commite o valor real.
# Local: .env.local (ignorado pelo Git). Produção: variáveis de ambiente da hospedagem.
# Chave da Gemini API (Google AI Studio). Deixe vazio aqui.
GOOGLE_GENERATIVE_AI_API_KEY=

# Segredo que assina o cookie do limite da demo. Mínimo 32 caracteres, aleatório, só no servidor.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Opcional: modelo usado pelos agentes (padrão em src/agents/modelo.ts).
#   sem barra  -> Google direto:  AGENTE_MODELO=gemini-3.5-flash
#   com barra  -> Vercel AI Gateway: AGENTE_MODELO=google/gemini-3.5-flash
# AGENTE_MODELO=

# Só se usar o AI Gateway (AGENTE_MODELO com barra). SEGREDO, só no servidor.
AI_GATEWAY_API_KEY=
